{
  "name": "qorex-integrations-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Packages and guides for adding the QoreX wallet to dApps on QoreChain, Ethereum-compatible networks, Cosmos chains and Solana.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "changeset": "changeset",
    "test:e2e": "pnpm --filter @qorechain/qorex-demo --filter @qorechain/qorex-example-playwright-e2e test:e2e"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "tsup": "8.5.1",
    "typedoc": "0.28.20",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "3.2.7"
  }
}
