{
  "$schema": "../chain.schema.json",
  "chain_name": "qorechain",
  "chain_type": "cosmos",
  "chain_id": "qorechain-vladi",
  "pretty_name": "QoreChain",
  "website": "https://www.qorechain.io",
  "status": "live",
  "network_type": "mainnet",
  "bech32_prefix": "qor",
  "daemon_name": "qorechaind",
  "node_home": "$HOME/.qorechaind",
  "key_algos": [
    "secp256k1"
  ],
  "slip44": 118,
  "description": "QoreChain is a Layer 1 with hybrid ML-DSA-87 (FIPS 204) plus secp256k1 signatures on its native lane. Accounts use standard secp256k1 keys (coin type 118). The chain also runs EVM (chain id 9801) and SVM execution over one unified account: the 20-byte account is shared across VMs, so the bech32 address (qor1...) carries the same bytes as the EVM 0x address, and the SVM address is those 20 bytes right-padded to 32 bytes and base58-encoded. Every VM reads the same native bank balance (1 QOR = 1,000,000 uqor).",
  "fees": {
    "fee_tokens": [
      {
        "denom": "uqor",
        "fixed_min_gas_price": 0.1,
        "low_gas_price": 0.1,
        "average_gas_price": 0.15,
        "high_gas_price": 0.25
      }
    ]
  },
  "staking": {
    "staking_tokens": [
      {
        "denom": "uqor"
      }
    ],
    "lock_duration": {
      "time": "1814400s"
    }
  },
  "codebase": {
    "git_repo": "https://github.com/qorechain/qorechain-core",
    "recommended_version": "v3.2.4",
    "compatible_versions": [
      "v3.2.4"
    ],
    "tag": "v3.2.4"
  },
  "logo_URIs": {
    "png": "https://raw.githubusercontent.com/cosmos/chain-registry/master/qorechain/images/qorechain.png"
  },
  "images": [
    {
      "png": "https://raw.githubusercontent.com/cosmos/chain-registry/master/qorechain/images/qorechain.png"
    }
  ],
  "apis": {
    "rpc": [
      {
        "address": "https://rpc.qore.host",
        "provider": "QoreChain"
      }
    ],
    "rest": [
      {
        "address": "https://api.qore.host",
        "provider": "QoreChain"
      }
    ],
    "wss": [
      {
        "address": "wss://rpc.qore.host/websocket",
        "provider": "QoreChain"
      }
    ],
    "evm-http-jsonrpc": [
      {
        "address": "https://evm.qore.host",
        "provider": "QoreChain"
      }
    ]
  },
  "explorers": [
    {
      "kind": "QoreChain Explorer",
      "url": "https://explore.qore.network",
      "tx_page": "https://explore.qore.network/tx/${txHash}",
      "account_page": "https://explore.qore.network/address/${accountAddress}",
      "validator_page": "https://explore.qore.network/validator/${validatorAddress}",
      "block_page": "https://explore.qore.network/block/${blockHeight}"
    }
  ],
  "keywords": [
    "mainnet",
    "pqc",
    "ml-dsa",
    "evm",
    "svm"
  ]
}
