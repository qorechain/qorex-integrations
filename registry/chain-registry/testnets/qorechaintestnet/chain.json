{
  "$schema": "../../chain.schema.json",
  "chain_name": "qorechaintestnet",
  "chain_type": "cosmos",
  "chain_id": "qorechain-diana",
  "pretty_name": "QoreChain Testnet",
  "website": "https://www.qorechain.io",
  "status": "live",
  "network_type": "testnet",
  "bech32_prefix": "qor",
  "daemon_name": "qorechaind",
  "node_home": "$HOME/.qorechaind",
  "key_algos": [
    "secp256k1"
  ],
  "slip44": 118,
  "description": "Public test network for QoreChain, a Layer 1 with hybrid ML-DSA-87 (FIPS 204) plus secp256k1 signatures on its native lane. Accounts use standard secp256k1 keys (coin type 118). The test network also runs EVM (chain id 9800) and SVM execution over one unified 20-byte account shared across VMs.",
  "fees": {
    "fee_tokens": [
      {
        "denom": "uqor",
        "fixed_min_gas_price": 0.1,
        "low_gas_price": 0.1,
        "average_gas_price": 0.15,
        "high_gas_price": 0.25
      }
    ]
  },
  "staking": {
    "staking_tokens": [
      {
        "denom": "uqor"
      }
    ],
    "lock_duration": {
      "time": "1814400s"
    }
  },
  "codebase": {
    "git_repo": "https://github.com/qorechain/qorechain-core",
    "recommended_version": "v3.2.6",
    "compatible_versions": [
      "v3.2.6"
    ]
  },
  "logo_URIs": {
    "png": "https://raw.githubusercontent.com/cosmos/chain-registry/master/qorechain/images/qorechain.png"
  },
  "images": [
    {
      "image_sync": {
        "chain_name": "qorechain"
      },
      "png": "https://raw.githubusercontent.com/cosmos/chain-registry/master/qorechain/images/qorechain.png"
    }
  ],
  "apis": {
    "rpc": [
      {
        "address": "https://rpc-testnet.qore.host",
        "provider": "QoreChain"
      }
    ],
    "rest": [
      {
        "address": "https://api-testnet.qore.host",
        "provider": "QoreChain"
      }
    ],
    "wss": [
      {
        "address": "wss://rpc-testnet.qore.host/websocket",
        "provider": "QoreChain"
      }
    ],
    "evm-http-jsonrpc": [
      {
        "address": "https://evm-testnet.qore.host",
        "provider": "QoreChain"
      }
    ]
  },
  "keywords": [
    "testnet",
    "pqc",
    "ml-dsa",
    "evm",
    "svm"
  ]
}
