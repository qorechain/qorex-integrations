{
  "name": "@qorechain/qorex-synpress",
  "version": "0.1.0",
  "description": "Playwright fixtures in the Synpress v4 style for dApps that use the QoreX wallet: a mock mode backed by @qorechain/qorex-wallet-mock.",
  "license": "Apache-2.0",
  "author": "QoreChain Association",
  "homepage": "https://github.com/qorechain/qorex-integrations/tree/main/packages/synpress#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qorechain/qorex-integrations.git",
    "directory": "packages/synpress"
  },
  "bugs": {
    "url": "https://github.com/qorechain/qorex-integrations/issues"
  },
  "keywords": [
    "qorex",
    "qorechain",
    "synpress",
    "playwright",
    "e2e",
    "testing",
    "wallet"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.16"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@qorechain/qorex-wallet-mock": "workspace:*"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.48.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
