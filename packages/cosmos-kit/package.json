{
  "name": "@qorechain/qorex-cosmos-kit",
  "version": "0.1.0",
  "description": "QoreX wallet for cosmos-kit, with the QoreChain signAndBroadcast path.",
  "license": "Apache-2.0",
  "author": "QoreChain Association",
  "homepage": "https://github.com/qorechain/qorex-integrations/tree/main/packages/cosmos-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qorechain/qorex-integrations.git",
    "directory": "packages/cosmos-kit"
  },
  "bugs": {
    "url": "https://github.com/qorechain/qorex-integrations/issues"
  },
  "keywords": [
    "qorex",
    "qorechain",
    "cosmos-kit",
    "cosmos",
    "wallet",
    "ml-dsa",
    "fips-204"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@qorechain/qorex-types": "workspace:*"
  },
  "peerDependencies": {
    "@cosmos-kit/core": "^2.18.1"
  },
  "devDependencies": {
    "@cosmos-kit/core": "2.18.1",
    "jsdom": "30.1.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
