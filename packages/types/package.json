{
  "name": "@qorechain/qorex-types",
  "version": "0.1.0",
  "description": "TypeScript types and detection helpers for the providers the QoreX wallet injects: EIP-1193 with EIP-6963, the QoreChain native provider and Solana Wallet Standard.",
  "license": "Apache-2.0",
  "author": "QoreChain Association",
  "homepage": "https://github.com/qorechain/qorex-integrations/tree/main/packages/types#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qorechain/qorex-integrations.git",
    "directory": "packages/types"
  },
  "bugs": {
    "url": "https://github.com/qorechain/qorex-integrations/issues"
  },
  "keywords": [
    "qorex",
    "qorechain",
    "wallet",
    "eip-1193",
    "eip-6963",
    "wallet-standard",
    "cosmos",
    "types"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./icon": {
      "import": {
        "types": "./dist/icon.d.ts",
        "default": "./dist/icon.js"
      },
      "require": {
        "types": "./dist/icon.d.cts",
        "default": "./dist/icon.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "jsdom": "30.1.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
