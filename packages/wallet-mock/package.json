{
  "name": "@qorechain/qorex-wallet-mock",
  "version": "0.1.0",
  "description": "Test double of the QoreX wallet for jsdom and Playwright: EIP-1193 with EIP-6963, the QoreChain native provider and Solana Wallet Standard, with real hybrid ML-DSA-87 signing on testnet.",
  "license": "Apache-2.0",
  "author": "QoreChain Association",
  "homepage": "https://github.com/qorechain/qorex-integrations/tree/main/packages/wallet-mock#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qorechain/qorex-integrations.git",
    "directory": "packages/wallet-mock"
  },
  "bugs": {
    "url": "https://github.com/qorechain/qorex-integrations/issues"
  },
  "keywords": [
    "qorex",
    "qorechain",
    "wallet",
    "mock",
    "testing",
    "playwright",
    "eip-1193",
    "eip-6963",
    "wallet-standard"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./inpage.global.js": "./dist/inpage.global.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.16"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "test": "vitest run",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@qorechain/qorex-types": "workspace:*",
    "@qorechain/qoresign": "0.1.0",
    "@scure/base": "2.4.0",
    "@scure/bip39": "2.4.0",
    "viem": "2.57.5"
  },
  "devDependencies": {
    "jsdom": "30.1.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
